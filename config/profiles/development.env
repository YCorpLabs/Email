# Maintainers' development build and local alpha. Keep these identifiers
# stable: stored Keychain items and local mail data depend on them. A checkout
# that needs a different bundle ID copies this file to an ignored
# config/<name>.local.env and selects it by path in
# config/distribution-profile.local. Never use this profile for a distributed
# build.
PROFILE=development
DISTRIBUTION=false
GOOGLE_CLIENT_ID_REQUIRED=true
GOOGLE_OAUTH_PUBLIC=true
MACOS_BUNDLE_ID=dev.email.client
MACOS_DATA_DIRECTORY=Email
KEYCHAIN_NAMESPACE=email.native.mail
LINUX_APP_ID=dev.email.client
LINUX_DATA_DIRECTORY=email-client
LINUX_SECRET_COLLECTION=Email
LINUX_DISPATCH_UNIT=email-dispatch
MCP_SERVER_NAME=email
SUPPORT_ADDRESS=support@ycorplabs.com
FEEDBACK_ADDRESS=feedback@ycorplabs.com
SCHEDULING_ORIGIN=https://meet.ycorplabs.com
UPDATE_FEED_URL=
UPDATE_PUBLIC_ED_KEY=
UPDATE_ALLOWED_HOSTS=
# Per-draft open tracking (Track opens) for maintainers' testing. Only a
# non-distribution profile with a Scheduling origin may enable it.
OPEN_TRACKING=true
