# Default for every build that selects no other profile: self-builds, forks
# and validation. The reserved .invalid domain can never belong to a publisher,
# so these identifiers cannot collide with any official build's app ID, Keychain
# items or data. No OAuth client, support channel, Scheduling service, update
# feed or third-party marks are included. Copy this file to start a fork profile.
PROFILE=unofficial
DISTRIBUTION=false
GOOGLE_CLIENT_ID_REQUIRED=false
GOOGLE_OAUTH_PUBLIC=true
MACOS_BUNDLE_ID=invalid.email.unofficial
MACOS_DATA_DIRECTORY=invalid.email.unofficial
KEYCHAIN_NAMESPACE=invalid.email.unofficial
LINUX_APP_ID=invalid.email.Unofficial
LINUX_DATA_DIRECTORY=invalid.email.Unofficial
LINUX_SECRET_COLLECTION=invalid.email.Unofficial
LINUX_DISPATCH_UNIT=invalid.email.Unofficial.dispatch
MCP_SERVER_NAME=email-unofficial
SUPPORT_ADDRESS=
FEEDBACK_ADDRESS=
SCHEDULING_ORIGIN=
UPDATE_FEED_URL=
UPDATE_PUBLIC_ED_KEY=
UPDATE_ALLOWED_HOSTS=
# No Scheduling service, so no open tracking.
OPEN_TRACKING=false
