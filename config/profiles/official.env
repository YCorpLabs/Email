# Official Y Corp AS production distribution. Signed releases only.
# Forks must not ship this profile; see FORKING.md and TRADEMARKS.md.
# Public values only. OAuth client IDs and the Google token-exchange value come
# from the release environment, never from this file.
PROFILE=official
DISTRIBUTION=true
GOOGLE_CLIENT_ID_REQUIRED=true
# One-click Google sign-in ("Google OAuth publicly available"). Off until
# Google's restricted-scope review passes, then maintainers set it true. Off, account
# setup offers Gmail only through an app password (docs/account-setup.md).
GOOGLE_OAUTH_PUBLIC=false
MACOS_BUNDLE_ID=com.ycorplabs.mail
MACOS_DATA_DIRECTORY=com.ycorplabs.mail
KEYCHAIN_NAMESPACE=com.ycorplabs.mail
LINUX_APP_ID=com.ycorplabs.Mail
LINUX_DATA_DIRECTORY=com.ycorplabs.Mail
LINUX_SECRET_COLLECTION=com.ycorplabs.Mail
LINUX_DISPATCH_UNIT=com.ycorplabs.Mail.dispatch
MCP_SERVER_NAME=email
SUPPORT_ADDRESS=support@ycorplabs.com
FEEDBACK_ADDRESS=feedback@ycorplabs.com
SCHEDULING_ORIGIN=https://meet.ycorplabs.com
# The production appcast and EdDSA public key are not provisioned yet. Until
# they are recorded here, --distribute requires EMAIL_UPDATE_FEED_URL and
# EMAIL_UPDATE_PUBLIC_ED_KEY; both must still match the hosts below.
UPDATE_FEED_URL=
UPDATE_PUBLIC_ED_KEY=
UPDATE_ALLOWED_HOSTS=ycorplabs.com updates.ycorplabs.com
# Released builds never track opens: a tracking pixel tells the sender when
# and where mail was read. Parsers refuse
# OPEN_TRACKING=true together with DISTRIBUTION=true.
OPEN_TRACKING=false
